---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<section class="bg-[#eeeeee]">
  <main class="pt-14 pb-12 md:pt-16 md:pb-20">
    <div class="mx-auto max-w-6xl text-center px-6">

      <h1
        class="text-54xl lg:text-5xl xl:text-6xl font-bold lg:tracking-tight xl:tracking-tighter">
        Plataforma de Dados e Apoio à Gestão de Acidentes por Animais Peçonhentos
      </h1>

      <p class="text-lg mt-6 text-slate-600 max-w-4xl mx-auto">
        Uma plataforma interativa para exploração e análise de dados epidemiológicos sobre 
        acidentes com animais peçonhentos no Estado de São Paulo, oferecendo visualizações, 
        indicadores e informações que apoiam a pesquisa, a gestão e a divulgação científica.
      </p>

