---
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Encontre atendimento",
    description:
      "Informe sua localização, o animal envolvido e o modo de transporte para consultar os Pontos Estratégicos de Soro Antiveneno mais próximos.",
    icon: "bx:bxs-map-pin",
    link: "/encontrar-soro",
    button: "Encontrar atendimento",
    destaque: true,
  },
  {
    title: "Guia de emergência",
    description:
      "Consulte orientações iniciais, cuidados, práticas contraindicadas e informações sobre soroterapia em acidentes por animais peçonhentos.",
    icon: "bx:bxs-first-aid",
    link: "/guia",
    button: "Acessar guia",
  },
  {
    title: "Dashboard epidemiológico",
    description:
      "Explore indicadores, mapas e séries históricas dos acidentes registrados no Estado de São Paulo.",
    icon: "bx:bxs-bar-chart-alt-2",
    link: "/dashboard",
    button: "Explorar dados",
  },
  {
    title: "Otimização da rede",
    description:
      "Conheça análises e modelos desenvolvidos para avaliar a cobertura e a distribuição territorial da rede soroterápica.",
    icon: "bx:bxs-network-chart",
    link: "/otimizacao",
    button: "Ver análises",
  },
];
---

<section class="mt-16">
  <div class="w-full">
    <p class="text-xs font-semibold uppercase tracking-wide text-blue-700">
      Explore a plataforma
    </p>

    <h2 class="mt-2 w-full text-3xl font-bold tracking-tight text-gray-800 md:text-4xl">
      Recursos para consulta, análise e apoio à gestão
    </h2>

    <p class="mt-4 w-full text-base leading-7 text-slate-600">
      A Rede de Soro Antiveneno SP reúne ferramentas voltadas ao público, à pesquisa e à análise
      da organização territorial do atendimento soroterápico.
    </p>
  </div>

  <div class="mt-9 grid gap-5 md:grid-cols-2">
    {
      features.map((item) => (
        <article
          class:list={[
            "group flex h-full flex-col rounded-xl border p-6 transition md:p-7",
            item.destaque
              ? "border-orange-200 bg-orange-50/50 hover:border-orange-300"
              : "border-slate-200 bg-white hover:border-blue-200 hover:shadow-sm",
          ]}
        >
          <div
            class:list={[
              "flex h-11 w-11 items-center justify-center rounded-lg",
              item.destaque
                ? "bg-orange-100 text-orange-700"
                : "bg-blue-50 text-[#0A2C57]",
            ]}
          >
            <Icon name={item.icon} class="h-6 w-6" />
          </div>

          <h3 class="mt-5 text-xl font-semibold text-[#0A2C57]">
            {item.title}
          </h3>

          <p class="mt-3 grow text-sm leading-6 text-slate-600">
            {item.description}
          </p>

          <a
            href={item.link}
            class:list={[
              "mt-6 inline-flex items-center gap-2 text-sm font-semibold transition",
              item.destaque
                ? "text-orange-700 hover:text-orange-800"
                : "text-blue-700 hover:text-blue-800",
            ]}
          >
            {item.button}
            <Icon
              name="bx:bx-right-arrow-alt"
              class="h-5 w-5 transition group-hover:translate-x-1"
            />
          </a>
        </article>
      ))
    }
  </div>
</section>
