---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Link from "@/components/ui/link.astro";

const features = [
  {
    title: "Dashboard Interativo",
    description:
      "Explore visualizações e indicadores sobre acidentes com animais peçonhentos no Estado de São Paulo.",
    icon: "bx:bxs-bar-chart-alt-2",
    link: "/dashboard",
    button: "Acessar Dashboard",
  },
  {
    title: "Guia Informativo",
    description:
      "Consulte informações sobre os principais animais peçonhentos, prevenção e orientações relacionadas aos acidentes.",
    icon: "bx:bxs-book-content",
    link: "/guia",
    button: "Acessar Guia",
  },
  {
    title: "Sobre o Projeto",
    description:
      "Conheça as publicações, participações em eventos e pesquisadores envolvidos no projeto.",
    icon: "bx:bxs-group",
    link: "/sobre",
    button: "Conhecer Projeto",
  },
];
---

<div class="mt-18">
  <h2 class="text-4xl lg:text-5xl font-bold tracking-tight">
    Principais Recursos
  </h2>

  <p class="text-lg mt-4 text-slate-600">
    Explore as principais funcionalidades da plataforma para consulta, análise e
    divulgação científica sobre acidentes com animais peçonhentos.
  </p>
</div>

<div class="grid md:grid-cols-3 gap-8 mt-8">
  {
    features.map((item) => (
      <div
        class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-md transition flex flex-col items-center text-center">

        <div class="bg-[#0A2C57] rounded-full w-14 h-14 flex items-center justify-center mb-6">
          <Icon
            class="text-white text-2xl"
            name={item.icon}
          />
        </div>

        <h3 class="text-2xl font-semibold text-[#0A2C57]">
          {item.title}
        </h3>

        <p class="text-slate-600 mt-4 leading-relaxed grow">
          {item.description}
        </p>

        <div class="mt-8">
          <Link href={item.link}>
            {item.button}
          </Link>
        </div>

      </div>
    ))
  }
</div>