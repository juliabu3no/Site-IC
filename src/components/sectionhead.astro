---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-16 flex flex-col gap-2", align === "center" && "text-center"]}>
  <h1 class="m-0 text-4xl lg:text-5xl font-bold lg:tracking-tight leading-tight">
    <slot name="title">Title</slot>
  </h1>

  <p class="m-0 text-lg text-slate-600 leading-relaxed">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>