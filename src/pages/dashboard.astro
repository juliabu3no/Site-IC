---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Dashboard">
  <Container>

    <div class="mt-12 text-center">
      <p class="text-3xl font-semibold text-slate-700">
        Explore os dados sobre acidentes com animais peçonhentos no estado de São Paulo
      </p>
    </div>


    <!-- FILTROS -->
    <section class="mx-auto max-w-5xl mt-12">
      <div class="grid md:grid-cols-3 gap-4">

        <!-- ANO -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">
            Ano
          </p>

          <details class="relative" id="dropdown-ano">
            <summary
              id="resumo-ano"
              class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center"
            >
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>

            <div
              id="ano-opcoes"
              class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"
            ></div>
          </details>
        </div>


        <!-- ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">
            Animal peçonhento
          </p>

          <details class="relative" id="dropdown-animal">
            <summary
              id="resumo-animal"
              class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center"
            >
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>

            <div
              id="animal-opcoes"
              class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"
            ></div>
          </details>
        </div>


        <!-- MUNICÍPIO -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">
            Município
          </p>

          <details class="relative" id="dropdown-municipio">
            <summary
              id="resumo-municipio"
              class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center"
            >
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>

            <div
              class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-md shadow-lg"
            >
              <!-- BUSCA -->
              <div class="p-2 border-b border-gray-100">
                <input
                  id="busca-municipio"
                  type="text"
                  placeholder="Buscar município..."
                  autocomplete="off"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm outline-none focus:border-[#0A2C57]"
                />
              </div>

              <!-- OPÇÕES -->
              <div
                id="municipio-opcoes"
                class="max-h-56 overflow-y-auto p-2"
              ></div>
            </div>
          </details>
        </div>

      </div>
    </section>


    <!-- INDICADORES -->
    <section class="mx-auto max-w-6xl mt-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="text-sm text-slate-500">Total de casos</p>
          <p id="total-casos" class="text-3xl font-bold text-[#0A2C57] mt-2">—</p>
        </div>

        <div class="border border-gray-200 rounded-lg p-5">
          <p class="text-sm text-slate-500">Óbitos</p>
          <p id="total-obitos" class="text-3xl font-bold text-[#0A2C57] mt-2">—</p>
        </div>

        <div class="border border-gray-200 rounded-lg p-5">
          <p class="text-sm text-slate-500">Taxa de letalidade</p>
          <p id="taxa-letalidade" class="text-3xl font-bold text-[#0A2C57] mt-2">—</p>
        </div>

        <div class="border border-gray-200 rounded-lg p-5">
          <p class="text-sm text-slate-500">Com soroterapia</p>
          <p id="percentual-soroterapia" class="text-3xl font-bold text-[#0A2C57] mt-2">—</p>
        </div>

        <div class="border border-gray-200 rounded-lg p-5">
          <p class="text-sm text-slate-500">Atendidos em até 3h</p>
          <p id="tempo-atendimento" class="text-3xl font-bold text-[#0A2C57] mt-2">—</p>
        </div>
      </div>
    </section>


    <!-- VISUALIZAÇÕES -->
    <section class="mx-auto max-w-5xl mt-12 mb-20">

      <h2 class="text-3xl font-bold text-gray-800 mb-6">
        Visualizações
      </h2>

      <div class="grid md:grid-cols-2 gap-6">

        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">
            Casos por tipo de animal
          </h3>

          <div
            id="grafico-animal"
            class="mt-4 min-h-64 flex items-center justify-center text-slate-400"
          >
            Carregando dados...
          </div>
        </div>


        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">
            Classificação dos casos
          </h3>

          <div
            id="grafico-gravidade"
            class="mt-4 min-h-64 flex items-center justify-center text-slate-400"
          >
            Carregando dados...
          </div>
        </div>


        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">
            Evolução dos casos ao longo dos anos
          </h3>

          <div
            id="grafico-temporal"
            class="mt-4 min-h-72 flex items-center justify-center text-slate-400"
          >
            Carregando dados...
          </div>
        </div>

      </div>

    </section>

  </Container>

  <script>
    let dadosBase = [];
    let dadosCards = [];

    async function carregarDashboard() {
      try {
        const [respostaFiltros, respostaBase, respostaCards] = await Promise.all([
          fetch("/data/filtros.json"),
          fetch("/data/base.json"),
          fetch("/data/cards.json"),
        ]);

        const filtros = await respostaFiltros.json();
        dadosBase = await respostaBase.json();
        dadosCards = await respostaCards.json();


        // -------------------------
        // CRIA DROPDOWN
        // -------------------------

        function criarFiltro(nome, valores) {
          const container = document.querySelector(`#${nome}-opcoes`);
          const resumo = document.querySelector(`#resumo-${nome}`);

          if (!container || !resumo) return;

          container.innerHTML = "";


          // opção TODOS
          const todos = document.createElement("label");

          todos.className =
            "flex items-center gap-2 px-2 py-2 rounded hover:bg-slate-50 cursor-pointer";

          todos.innerHTML = `
            <input
              type="checkbox"
              value="todos"
              data-filtro="${nome}"
              checked
              class="accent-[#0A2C57]"
            >
            <span class="text-sm text-slate-700">Todos</span>
          `;

          container.appendChild(todos);


          // outras opções
          valores.forEach((valor, indice) => {
            const item = document.createElement("label");

            item.className =
              "flex items-center gap-2 px-2 py-2 rounded hover:bg-slate-50 cursor-pointer";

            item.innerHTML = `
              <input
                type="checkbox"
                value="${indice}"
                data-filtro="${nome}"
                class="accent-[#0A2C57]"
              >
              <span class="text-sm text-slate-700">
                ${valor}
              </span>
            `;

            container.appendChild(item);
          });


          // comportamento das caixas
          container.addEventListener("change", (evento) => {
            const alvo = evento.target;

            if (!(alvo instanceof HTMLInputElement)) return;

            const checkboxes = Array.from(
              container.querySelectorAll('input[type="checkbox"]')
            );

            const checkboxTodos = checkboxes[0];


            // marcou TODOS
            if (alvo.value === "todos" && alvo.checked) {
              checkboxes.slice(1).forEach((checkbox) => {
                checkbox.checked = false;
              });
            }

            // marcou opção específica
            if (alvo.value !== "todos" && alvo.checked) {
              checkboxTodos.checked = false;
            }


            // se nada estiver marcado → volta para Todos
            const algumMarcado = checkboxes.some(
              (checkbox) => checkbox.checked
            );

            if (!algumMarcado) {
              checkboxTodos.checked = true;
            }


            atualizarResumo(nome, valores);
            atualizarIndicadores();
          });
        }


        // -------------------------
        // TEXTO DO DROPDOWN
        // -------------------------

        function atualizarResumo(nome, valores) {
          const container = document.querySelector(`#${nome}-opcoes`);
          const resumo = document.querySelector(`#resumo-${nome} span`);

          if (!container || !resumo) return;

          const selecionados = Array.from(
            container.querySelectorAll('input[type="checkbox"]:checked')
          );

          if (
            selecionados.length === 0 ||
            selecionados.some((item) => item.value === "todos")
          ) {
            resumo.textContent = "Todos";
            return;
          }

          if (selecionados.length === 1) {
            const indice = Number(selecionados[0].value);

            resumo.textContent = valores[indice];
            return;
          }

          resumo.textContent =
            `${selecionados.length} selecionados`;
        }


        // -------------------------
        // VALORES SELECIONADOS
        // -------------------------

        function valoresSelecionados(nome) {
          const container =
            document.querySelector(`#${nome}-opcoes`);

          if (!container) return ["todos"];

          return Array.from(
            container.querySelectorAll(
              'input[type="checkbox"]:checked'
            )
          ).map((item) => item.value);
        }


        // -------------------------
        // INDICADORES
        // -------------------------

        function atualizarIndicadores() {
          const anos = valoresSelecionados("ano");
          const animais = valoresSelecionados("animal");
          const municipios = valoresSelecionados("municipio");

          const todosAnos = anos.includes("todos");
          const todosAnimais = animais.includes("todos");
          const todosMunicipios = municipios.includes("todos");

          const dadosFiltrados = dadosCards.filter((linha) => {
            const ano = String(linha[0]);
            const animal = String(linha[1]);
            const municipio = String(linha[2]);

            return (
              (todosAnos || anos.includes(ano)) &&
              (todosAnimais || animais.includes(animal)) &&
              (todosMunicipios || municipios.includes(municipio))
            );
          });

          let totalCasos = 0;
          let totalObitos = 0;
          let soroterapiaSim = 0;
          let soroterapiaConhecida = 0;
          let atendimentoAte3h = 0;
          let tempoConhecido = 0;

          dadosFiltrados.forEach((linha) => {
            totalCasos += linha[3];
            totalObitos += linha[4];
            soroterapiaSim += linha[5];
            soroterapiaConhecida += linha[6];
            atendimentoAte3h += linha[7];
            tempoConhecido += linha[8];
          });

          const taxaLetalidade =
            totalCasos > 0
              ? (totalObitos / totalCasos) * 100
              : null;

          const percentualSoroterapia =
            soroterapiaConhecida > 0
              ? (soroterapiaSim / soroterapiaConhecida) * 100
              : null;

          const percentualAte3h =
            tempoConhecido > 0
              ? (atendimentoAte3h / tempoConhecido) * 100
              : null;

          const formatarPercentual = (valor) =>
            valor === null
              ? "—"
              : `${valor.toFixed(2).replace(".", ",")}%`;

          const elementoCasos = document.querySelector("#total-casos");
          const elementoObitos = document.querySelector("#total-obitos");
          const elementoLetalidade = document.querySelector("#taxa-letalidade");
          const elementoSoroterapia = document.querySelector("#percentual-soroterapia");
          const elementoTempo = document.querySelector("#tempo-atendimento");

          if (elementoCasos) {
            elementoCasos.textContent = totalCasos.toLocaleString("pt-BR");
          }

          if (elementoObitos) {
            elementoObitos.textContent = totalObitos.toLocaleString("pt-BR");
          }

          if (elementoLetalidade) {
            elementoLetalidade.textContent = formatarPercentual(taxaLetalidade);
          }

          if (elementoSoroterapia) {
            elementoSoroterapia.textContent = formatarPercentual(percentualSoroterapia);
          }

          if (elementoTempo) {
            elementoTempo.textContent = formatarPercentual(percentualAte3h);
          }
        }


        // cria os três filtros
        criarFiltro("ano", filtros.anos);
        criarFiltro("animal", filtros.animais);
        criarFiltro("municipio", filtros.municipios);

        // -------------------------
        // BUSCA DE MUNICÍPIO
        // -------------------------

        const buscaMunicipio =
          document.querySelector("#busca-municipio");

        const opcoesMunicipio =
          document.querySelector("#municipio-opcoes");


        buscaMunicipio?.addEventListener("input", () => {
          if (!opcoesMunicipio) return;

          const normalizar = (texto) =>
            texto
              .toLowerCase()
              .normalize("NFD")
              .replace(/[\u0300-\u036f]/g, "");

          const termo = normalizar(buscaMunicipio.value);

          const opcoes =
            opcoesMunicipio.querySelectorAll("label");

          opcoes.forEach((opcao, indice) => {

            // mantém "Todos" sempre aparecendo
            if (indice === 0) {
              opcao.style.display = "flex";
              return;
            }

            const texto = normalizar(
              opcao.textContent || ""
            );

            opcao.style.display =
              texto.includes(termo)
                ? "flex"
                : "none";
          });
        });

        // valores iniciais
        atualizarIndicadores();

      } catch (erro) {
        console.error(
          "Erro ao carregar o dashboard:",
          erro
        );
      }
    }

    carregarDashboard();
  </script>
</Layout>