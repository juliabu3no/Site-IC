    function atualizarGraficoSoroterapia(totais) {
      const sim = totais.soroterapiaSim;
      const nao = Math.max(
        totais.soroterapiaConhecida - totais.soroterapiaSim,
        0
      );
      const ignorado = Math.max(
        totais.casos - totais.soroterapiaConhecida,
        0
      );

      renderizarGrafico(
        "soroterapia",
        "#grafico-soroterapia",
        configuracaoPizza(
          ["Sim", "Não", "Ignorado"],
          [sim, nao, ignorado],
          [
            CORES_SOROTERAPIA.sim,
            CORES_SOROTERAPIA.nao,
            CORES_SOROTERAPIA.ignorado,
          ]
        )
      );
    }

    function atualizarPainelEvolucao(dadosFiltrados) {
      const container = document.querySelector("#painel-evolucao");
      if (!container) return;

      const casosPorEvolucao = somarPor(
        dadosFiltrados,
        INDICE_CARDS.evolucao,
        INDICE_CARDS.casos
      );

      const total = [...casosPorEvolucao.values()]
        .reduce((soma, valor) => soma + valor, 0);

      const indices = [...casosPorEvolucao.keys()]
        .sort((a, b) => casosPorEvolucao.get(b) - casosPorEvolucao.get(a));

      container.innerHTML = "";

      indices.forEach((indice) => {
        const nome = filtros.evolucoes[indice];
        const casos = casosPorEvolucao.get(indice) || 0;
        const percentual = total > 0 ? (casos / total) * 100 : 0;

        const item = document.createElement("div");
        item.className =
          "flex min-h-36 flex-col justify-between rounded-lg border border-slate-200 bg-white p-4";

        const topo = document.createElement("div");
        topo.className = "flex min-w-0 items-start gap-2";

        const marcador = document.createElement("span");
        marcador.className = "mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full";
        marcador.style.backgroundColor =
          CORES_EVOLUCAO[nome] || "#64748B";

        const titulo = document.createElement("p");
        titulo.className =
          "min-w-0 text-sm font-medium leading-5 text-slate-600";
        titulo.textContent = nome;

        topo.append(marcador, titulo);

        const numeros = document.createElement("div");
        numeros.className = "mt-4";

        const valor = document.createElement("p");
        valor.className =
          "text-2xl font-bold leading-none text-[#0A2C57]";
        valor.textContent = formatarNumero(casos);

        const proporcao = document.createElement("p");
        proporcao.className =
          "mt-2 text-sm leading-5 text-slate-500";
        proporcao.textContent =
          `${formatarPercentual(percentual, 2)} dos casos`;

        numeros.append(valor, proporcao);
        item.append(topo, numeros);
        container.appendChild(item);
      });
    }

