              },
            },
          },
        },
      };
    }

    function configuracaoBarrasEmpilhadas(labels, datasets, tituloEixoX) {
      return {
        type: "bar",
        data: {
          labels,
          datasets,
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
