---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout title="Dashboard">
  <Container>
    <div class="mt-12 text-center">
      <p class="text-3xl font-semibold text-slate-700">
        Explore os dados sobre acidentes com animais peçonhentos no estado de São Paulo
      </p>
    </div>

    <!-- FILTROS -->
    <section class="mx-auto max-w-6xl mt-12">
      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- ANO -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">Ano</p>
          <details class="relative" id="dropdown-ano">
            <summary id="resumo-ano" class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center">
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>
            <div id="ano-opcoes" class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"></div>
          </details>
        </div>

        <!-- ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">Animal peçonhento</p>
          <details class="relative" id="dropdown-animal">
            <summary id="resumo-animal" class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center">
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>
            <div id="animal-opcoes" class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"></div>
          </details>
        </div>

        <!-- MUNICÍPIO -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">Município</p>
          <details class="relative" id="dropdown-municipio">
            <summary id="resumo-municipio" class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center">
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>
            <div class="absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-md shadow-lg">
              <div class="p-2 border-b border-gray-100">
                <input
                  id="busca-municipio"
                  type="text"
                  placeholder="Buscar município..."
                  autocomplete="off"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm outline-none focus:border-[#0A2C57]"
                />
              </div>
              <div id="municipio-opcoes" class="max-h-56 overflow-y-auto p-2"></div>
            </div>
          </details>
        </div>

        <!-- GRAVIDADE -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">Gravidade</p>
          <details class="relative" id="dropdown-gravidade">
            <summary id="resumo-gravidade" class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center">
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>
            <div id="gravidade-opcoes" class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"></div>
          </details>
        </div>

        <!-- EVOLUÇÃO -->
        <div class="border border-gray-200 rounded-lg p-5">
          <p class="block text-sm font-semibold text-gray-700 mb-2">Desfecho</p>
          <details class="relative" id="dropdown-evolucao">
            <summary id="resumo-evolucao" class="list-none cursor-pointer w-full border border-gray-300 rounded-md px-3 py-2 bg-white flex justify-between items-center">
              <span>Todos</span>
              <span class="text-slate-400">⌄</span>
            </summary>
            <div id="evolucao-opcoes" class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-2"></div>
          </details>
        </div>
      </div>
    </section>

    <!-- VISÃO GERAL -->
    <section class="mx-auto max-w-6xl mt-12">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[#0A2C57]">Visão geral</h2>
        <p class="mt-1 text-sm text-slate-500">
          Síntese dos casos selecionados e evolução ao longo do período.
        </p>
      </div>

      <!-- INDICADORES -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Total de casos</p>
          <p id="total-casos" class="mt-2 text-2xl font-bold text-[#0A2C57]">—</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Óbitos pelo acidente</p>
          <p id="total-obitos" class="mt-2 text-2xl font-bold text-[#0A2C57]">—</p>
          <p id="percentual-obitos" class="mt-1 text-xs leading-tight text-slate-500">—</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Com soroterapia</p>
          <p id="total-soroterapia" class="mt-2 text-2xl font-bold text-[#0A2C57]">—</p>
          <p id="percentual-soroterapia" class="mt-1 text-xs leading-tight text-slate-500">—</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Atendidos em até 3h</p>
          <p id="total-ate3h" class="mt-2 text-2xl font-bold text-[#0A2C57]">—</p>
          <p id="percentual-ate3h" class="mt-1 text-xs leading-tight text-slate-500">—</p>
        </div>
      </div>

      <!-- EVOLUÇÃO ANUAL -->
      <div class="mt-6 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-gray-800">
          Evolução dos casos e óbitos ao longo dos anos
        </h3>
        <div class="mt-4 h-72">
          <canvas id="grafico-temporal"></canvas>
        </div>
      </div>
    </section>

    <!-- PERFIL DOS ACIDENTES -->
    <section class="mx-auto max-w-6xl mt-16">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[#0A2C57]">Perfil dos acidentes</h2>
        <p class="mt-1 text-sm text-slate-500">
          Distribuição dos casos por animal, gravidade e período de ocorrência.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Casos por tipo de animal</h3>
          <div class="mt-4 h-72">
            <canvas id="grafico-animal"></canvas>
          </div>
        </div>

        <!-- GRAVIDADE -->
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Classificação dos casos</h3>
          <div class="mt-4 h-72">
            <canvas id="grafico-gravidade"></canvas>
          </div>
        </div>

        <!-- SUBTIPO DO ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">Subtipo do animal envolvido</h3>
          <p class="mt-1 text-sm text-slate-500">
            Informação disponível para acidentes por serpentes, aranhas e lagartas.
          </p>
          <div class="mt-4 h-[420px]">
            <canvas id="grafico-subtipo-animal"></canvas>
          </div>
        </div>

        <!-- GRAVIDADE POR ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">Gravidade por tipo de animal</h3>
          <p class="mt-1 text-sm text-slate-500">
            Distribuição percentual da gravidade dentro de cada tipo de acidente.
          </p>
          <div class="mt-4 h-80">
            <canvas id="grafico-gravidade-animal"></canvas>
          </div>
        </div>

        <!-- MÊS -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">Distribuição mensal dos casos</h3>
          <div class="mt-4 h-80">
            <canvas id="grafico-mes"></canvas>
          </div>
        </div>

        <!-- SEMANA EPIDEMIOLÓGICA -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">
            Casos por semana epidemiológica
          </h3>
          <div class="mt-4 h-96">
            <canvas id="grafico-semana"></canvas>
          </div>
        </div>

        <!-- OUTRAS CARACTERÍSTICAS DO ACIDENTE -->
        <div class="md:col-span-2 grid lg:grid-cols-3 gap-6">
          <div class="border border-gray-200 rounded-lg p-6 lg:col-span-2">
            <h3 class="font-semibold text-gray-800">Local da picada</h3>
            <div class="mt-4 h-96">
              <canvas id="grafico-local-picada"></canvas>
            </div>
          </div>

          <div class="border border-gray-200 rounded-lg p-6">
            <h3 class="font-semibold text-gray-800">
              Acidente relacionado ao trabalho
            </h3>
            <div class="mt-4 h-72">
              <canvas id="grafico-trabalho"></canvas>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PERFIL DAS VÍTIMAS -->
    <section class="mx-auto max-w-6xl mt-16">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[#0A2C57]">Perfil das vítimas</h2>
        <p class="mt-1 text-sm text-slate-500">
          Distribuição dos casos segundo faixa etária e sexo registrado.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-2">
          <h3 class="font-semibold text-gray-800">Casos por faixa etária</h3>
          <div class="mt-4 h-80">
            <canvas id="grafico-faixa-etaria"></canvas>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Casos por sexo</h3>
          <div class="mt-4 h-80">
            <canvas id="grafico-sexo"></canvas>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Raça/cor autodeclarada</h3>
          <div class="mt-4 h-80">
            <canvas id="grafico-raca-cor"></canvas>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-2">
          <h3 class="font-semibold text-gray-800">Escolaridade</h3>
          <div class="mt-4 h-96">
            <canvas id="grafico-escolaridade"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- ATENDIMENTO E DESFECHO -->
    <section class="mx-auto max-w-6xl mt-16">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[#0A2C57]">Atendimento e desfecho</h2>
        <p class="mt-1 text-sm text-slate-500">
          Tempo até o atendimento e evolução dos casos registrados.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- TEMPO -->
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Tempo até o atendimento</h3>
          <div class="mt-4 h-72">
            <canvas id="grafico-tempo"></canvas>
          </div>
        </div>

        <!-- DESFECHO -->
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Desfecho dos casos</h3>
          <p class="mt-1 text-sm text-slate-500">
            Número e percentual de casos em cada categoria de evolução.
          </p>
          <div id="painel-evolucao" class="mt-5 grid sm:grid-cols-2 gap-3"></div>
        </div>

        <!-- TEMPO POR GRAVIDADE -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">Tempo de atendimento por gravidade</h3>
          <p class="mt-1 text-sm text-slate-500">
            Distribuição percentual do tempo até o atendimento dentro de cada classificação de gravidade.
          </p>
          <div class="mt-4 h-80">
            <canvas id="grafico-tempo-gravidade"></canvas>
          </div>
        </div>

        <!-- ÓBITOS POR ANIMAL -->
        <div class="border border-gray-200 rounded-lg p-6 md:col-span-2">
          <h3 class="font-semibold text-gray-800">Óbitos por tipo de animal</h3>
          <p class="mt-1 text-sm text-slate-500">
            Número de óbitos pelo acidente; a letalidade aparece no detalhamento.
          </p>
          <div class="mt-4 h-80">
            <canvas id="grafico-obitos-animal"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- SOROTERAPIA -->
    <section class="mx-auto max-w-6xl mt-16 mb-20">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[#0A2C57]">Soroterapia</h2>
        <p class="mt-1 text-sm text-slate-500">
          Uso de antivenenos e distribuição das ampolas administradas.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <!-- USO DE SOROTERAPIA -->
        <div class="border border-gray-200 rounded-lg p-6">
          <h3 class="font-semibold text-gray-800">Uso de soroterapia</h3>
          <div class="mt-4 h-72">
            <canvas id="grafico-soroterapia"></canvas>
          </div>
        </div>

        <!-- TIPO DE SORO -->
        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-2">
          <h3 class="font-semibold text-gray-800">Tipo de soro utilizado</h3>
          <p class="mt-1 text-sm text-slate-500">
            Casos com uso registrado de cada soro, independentemente do número de ampolas.
          </p>
          <div class="mt-4 h-96">
            <canvas id="grafico-soros"></canvas>
          </div>
        </div>

        <!-- SOROTERAPIA POR GRAVIDADE -->
        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-3">
          <h3 class="font-semibold text-gray-800">Soroterapia por gravidade</h3>
          <p class="mt-1 text-sm text-slate-500">
            Distribuição percentual do uso de soroterapia em cada classificação de gravidade.
          </p>
          <div class="mt-4 h-80">
            <canvas id="grafico-soroterapia-gravidade"></canvas>
          </div>
        </div>

        <!-- TOTAL DE AMPOLAS -->
        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-3">
          <h3 class="font-semibold text-gray-800">Total de ampolas por tipo de soro</h3>
          <p class="mt-1 text-sm text-slate-500">
            Soma das ampolas registradas nos casos com uso de cada tipo de soro.
          </p>
          <div class="mt-4 h-96">
            <canvas id="grafico-ampolas-totais"></canvas>
          </div>
        </div>

        <!-- DISTRIBUIÇÃO DE AMPOLAS -->
        <div class="border border-gray-200 rounded-lg p-6 lg:col-span-3">
          <h3 class="font-semibold text-gray-800">
            Distribuição do número de ampolas por caso
          </h3>
          <p class="mt-1 text-sm text-slate-500">
            Percentual de casos em cada faixa de ampolas, entre os registros com uso do respectivo soro.
          </p>
          <div class="mt-4 h-[30rem]">
            <canvas id="grafico-ampolas"></canvas>
          </div>
        </div>
      </div>
    </section>
  </Container>

  <script>
    import Chart from "chart.js/auto";

    // =========================
    // ESTADO E CONSTANTES
    // =========================
    let filtros = {};
    let dadosCards = [];
    let dadosTempo = [];
    let dadosMes = [];
    let dadosSemana = [];
    let dadosFaixaEtaria = [];
    let dadosSexo = [];
    let dadosLocalPicada = [];
    let dadosAcidenteTrabalho = [];
    let dadosRacaCor = [];
    let dadosEscolaridade = [];
    let dadosSubtipoAnimal = [];
    let dadosSoros = [];
    let dadosAmpolasTotais = [];
    let dadosAmpolas = [];

    // Guarda as instâncias para destruí-las antes de redesenhar.
    const graficos = new Map();

    const COR_PRIMARIA = "#0A2C57";
    const COR_OBITOS = "#B91C1C";
    const CORES_GRAVIDADE = ["#0A2C57", "#4F86C6", "#B91C1C", "#94A3B8"];

    // Paleta acessível e coerente com a identidade visual do site.
    const CORES_ANIMAIS = {
      "Serpente": "#C47A00",
      "Aranha": "#6D4C8E",
      "Escorpião": "#4F86C6",
      "Lagarta": "#0F766E",
      "Abelha": "#0A2C57",
      "Outros": "#64748B",
      "Outro": "#64748B",
      "Ignorado": "#CBD5E1",
    };

    const CORES_SOROTERAPIA = {
      sim: "#0A2C57",
      nao: "#6D4C8E",
      ignorado: "#94A3B8",
    };

    const CORES_EVOLUCAO = {
      "Cura": "#0F766E",
      "Óbito por acidente por animais peçonhentos": "#B91C1C",
      "Óbito por outras causas": "#6D4C8E",
      "Ignorado": "#94A3B8",
      "Sem informação": "#CBD5E1",
    };

    const CORES_FAIXAS_AMPOLAS = [
      "#4F86C6",
      "#0F766E",
      "#6D4C8E",
      "#C47A00",
      "#64748B",
      "#0A2C57",
    ];

    const CORES_CATEGORIAS = {
      principal: "#0A2C57",
      secundaria: "#4F86C6",
      destaque: "#C47A00",
      ignorado: "#94A3B8",
    };

    // Os cinco primeiros campos são iguais em todos os JSONs agregados.
    const INDICE_COMUM = {
      ano: 0,
      animal: 1,
      municipio: 2,
      gravidade: 3,
      evolucao: 4,
    };

    const INDICE_CARDS = {
      ...INDICE_COMUM,
      casos: 5,
      obitos: 6,
      soroterapiaSim: 7,
      soroterapiaConhecida: 8,
      atendimentoAte3h: 9,
      tempoConhecido: 10,
    };

    // mes.json, tempo.json, semana.json e soros.json:
    // [y, a, m, g, e, categoria, casos]
    const INDICE_SERIE = {
      categoria: 5,
      casos: 6,
    };

    const INDICE_AMPOLAS = {
      soro: 5,
      faixa: 6,
      casos: 7,
    };

    // ampolas_totais.json: [y, a, m, g, e, soro, ampolas, casos]
    const INDICE_AMPOLAS_TOTAIS = {
      soro: 5,
      ampolas: 6,
      casos: 7,
    };

    const ORDEM_TEMPOS = [1, 2, 3, 4, 5, 6, 9];
    const MAPA_TEMPOS = {
      1: "0 a 1 hora",
      2: "1 a 3 horas",
      3: "3 a 6 horas",
      4: "6 a 12 horas",
      5: "12 a 24 horas",
      6: "24 horas ou mais",
      9: "Ignorado",
    };

    const CORES_TEMPO = {
      1: "#0A2C57",
      2: "#4F86C6",
      3: "#0F766E",
      4: "#6D4C8E",
      5: "#C47A00",
      6: "#64748B",
      9: "#CBD5E1",
    };

    const ORDEM_MESES = Array.from({ length: 12 }, (_, indice) => indice + 1);
    const MAPA_MESES = {
      1: "Jan",
      2: "Fev",
      3: "Mar",
      4: "Abr",
      5: "Mai",
      6: "Jun",
      7: "Jul",
      8: "Ago",
      9: "Set",
      10: "Out",
      11: "Nov",
      12: "Dez",
    };

    const ORDEM_SEMANAS = Array.from({ length: 53 }, (_, indice) => indice + 1);

    // =========================
    // FUNÇÕES AUXILIARES
    // =========================
    function valoresSelecionados(nome) {
      const container = document.querySelector(`#${nome}-opcoes`);
      if (!container) return ["todos"];

      return Array.from(
        container.querySelectorAll('input[type="checkbox"]:checked')
      ).map((item) => item.value);
    }

    function obterSelecaoAtual() {
      return {
        ano: valoresSelecionados("ano"),
        animal: valoresSelecionados("animal"),
        municipio: valoresSelecionados("municipio"),
        gravidade: valoresSelecionados("gravidade"),
        evolucao: valoresSelecionados("evolucao"),
      };
    }

    function atendeFiltro(valor, selecionados) {
      return (
        selecionados.includes("todos") ||
        selecionados.includes(String(valor))
      );
    }

    function filtrarDados(dados, selecao) {
      return dados.filter((linha) =>
        atendeFiltro(linha[INDICE_COMUM.ano], selecao.ano) &&
        atendeFiltro(linha[INDICE_COMUM.animal], selecao.animal) &&
        atendeFiltro(linha[INDICE_COMUM.municipio], selecao.municipio) &&
        atendeFiltro(linha[INDICE_COMUM.gravidade], selecao.gravidade) &&
        atendeFiltro(linha[INDICE_COMUM.evolucao], selecao.evolucao)
      );
    }

    function formatarPercentual(valor, casas = 2) {
      if (valor === null || !Number.isFinite(valor)) return "—";
      return `${valor.toFixed(casas).replace(".", ",")}%`;
    }

    function formatarNumero(valor) {
      return Number(valor).toLocaleString("pt-BR");
    }

    function somarPor(dados, indiceChave, indiceValor) {
      const totais = new Map();

      dados.forEach((linha) => {
        const chave = Number(linha[indiceChave]);
        const valor = Number(linha[indiceValor]);
        totais.set(chave, (totais.get(chave) || 0) + valor);
      });

      return totais;
    }

    function agruparDuasCategorias(
      dados,
      indiceLinha,
      indiceColuna,
      indiceValor
    ) {
      const matriz = new Map();
      const totais = new Map();
      const linhas = new Set();

      dados.forEach((linha) => {
        const categoriaLinha = Number(linha[indiceLinha]);
        const categoriaColuna = Number(linha[indiceColuna]);
        const valor = Number(linha[indiceValor]);
        const chave = `${categoriaLinha}-${categoriaColuna}`;

        linhas.add(categoriaLinha);
        matriz.set(chave, (matriz.get(chave) || 0) + valor);
        totais.set(
          categoriaLinha,
          (totais.get(categoriaLinha) || 0) + valor
        );
      });

      return { matriz, totais, linhas: [...linhas] };
    }

    function criarDatasetsPercentuais(
      indicesLinhas,
      categorias,
      matriz,
      totais,
      obterRotulo,
      obterCor
    ) {
      return categorias.map((categoria) => {
        const casosAbsolutos = indicesLinhas.map(
          (linha) => matriz.get(`${linha}-${categoria}`) || 0
        );

        return {
          label: obterRotulo(categoria),
          data: indicesLinhas.map((linha, indice) => {
            const total = totais.get(linha) || 0;
            return total > 0
              ? (casosAbsolutos[indice] / total) * 100
              : 0;
          }),
          casosAbsolutos,
          backgroundColor: obterCor(categoria),
          borderColor: "#FFFFFF",
          borderWidth: 1,
        };
      });
    }

    function prepararSerieOrdenada(
      dados,
      ordem,
      mapaRotulos = null,
      preencherZeros = false
    ) {
      const totais = somarPor(
        dados,
        INDICE_SERIE.categoria,
        INDICE_SERIE.casos
      );

      // Em séries temporais, mantém meses/semanas sem casos como zero
      // para preservar a continuidade do eixo.
      const categorias = preencherZeros
        ? ordem
        : ordem.filter((categoria) => totais.has(categoria));

      return {
        labels: categorias.map((categoria) =>
          mapaRotulos ? mapaRotulos[categoria] : String(categoria)
        ),
        valores: categorias.map((categoria) => totais.get(categoria) || 0),
      };
    }

    function obterCorAnimal(nomeAnimal) {
      return CORES_ANIMAIS[nomeAnimal] || "#94A3B8";
    }

    function prepararSeriesPorAnimal(dados, ordemCategorias, mapaRotulos = null) {
      const animaisPresentes = [
        ...new Set(dados.map((linha) => Number(linha[INDICE_COMUM.animal])))
      ].sort((a, b) => a - b);

      const totais = new Map();

      dados.forEach((linha) => {
        const animal = Number(linha[INDICE_COMUM.animal]);
        const categoria = Number(linha[INDICE_SERIE.categoria]);
        const casos = Number(linha[INDICE_SERIE.casos]);
        const chave = `${animal}-${categoria}`;

        totais.set(chave, (totais.get(chave) || 0) + casos);
      });

      const labels = ordemCategorias.map((categoria) =>
        mapaRotulos ? mapaRotulos[categoria] : String(categoria)
      );

      const datasets = animaisPresentes.map((animal) => {
        const nomeAnimal = filtros.animais[animal];

        return {
          label: nomeAnimal,
          data: ordemCategorias.map(
            (categoria) => totais.get(`${animal}-${categoria}`) || 0
          ),
          backgroundColor: obterCorAnimal(nomeAnimal),
          borderColor: "#FFFFFF",
          borderWidth: 1,
        };
      });

      return { labels, datasets };
    }

    function renderizarGrafico(nome, seletor, configuracao) {
      const canvas = document.querySelector(seletor);
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const graficoAnterior = graficos.get(nome);
      if (graficoAnterior) graficoAnterior.destroy();

      graficos.set(nome, new Chart(canvas, configuracao));
    }

    function configuracaoPizza(labels, valores, cores) {
      return {
        type: "pie",
        data: {
          labels,
          datasets: [
            {
              data: valores,
              backgroundColor: cores,
              borderColor: "#FFFFFF",
              borderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: {
                usePointStyle: true,
                boxWidth: 10,
                padding: 14,
              },
            },
            tooltip: {
              callbacks: {
                label: (contexto) => {
                  const valor = Number(contexto.raw);
                  const total = contexto.dataset.data.reduce(
                    (soma, numero) => soma + Number(numero),
                    0
                  );
                  const percentual = total > 0 ? (valor / total) * 100 : 0;

                  return `${contexto.label}: ${formatarNumero(
                    valor
                  )} (${formatarPercentual(percentual, 1)})`;
                },
              },
            },
          },
        },
      };
    }

