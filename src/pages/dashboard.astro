    async function carregarJson(caminho) {
      const resposta = await fetch(caminho);

      if (!resposta.ok) {
        throw new Error(`Erro ao carregar ${caminho}: ${resposta.status}`);
      }

      return resposta.json();
    }

    function resumirCards(dados) {
      return dados.reduce(
        (total, linha) => {
          total.casos += linha[INDICE_CARDS.casos];
          total.obitos += linha[INDICE_CARDS.obitos];
          total.soroterapiaSim += linha[INDICE_CARDS.soroterapiaSim];
          total.soroterapiaConhecida += linha[INDICE_CARDS.soroterapiaConhecida];
          total.atendimentoAte3h += linha[INDICE_CARDS.atendimentoAte3h];
          total.tempoConhecido += linha[INDICE_CARDS.tempoConhecido];
          return total;
        },
        {
          casos: 0,
          obitos: 0,
          soroterapiaSim: 0,
          soroterapiaConhecida: 0,
          atendimentoAte3h: 0,
          tempoConhecido: 0,
        }
      );
    }

    // =========================
    // INDICADORES
    // =========================
    function atualizarIndicadores(totais) {
      const percentualObitos =
        totais.casos > 0
          ? (totais.obitos / totais.casos) * 100
          : null;

      const percentualSoroterapia =
        totais.soroterapiaConhecida > 0
          ? (totais.soroterapiaSim / totais.soroterapiaConhecida) * 100
          : null;

      const percentualAte3h =
        totais.tempoConhecido > 0
          ? (totais.atendimentoAte3h / totais.tempoConhecido) * 100
          : null;

      const valores = {
        "#total-casos": formatarNumero(totais.casos),
        "#total-obitos": formatarNumero(totais.obitos),
        "#percentual-obitos":
          percentualObitos === null
            ? "—"
            : `${formatarPercentual(percentualObitos)} dos casos`,
        "#total-soroterapia": formatarNumero(totais.soroterapiaSim),
        "#percentual-soroterapia":
          percentualSoroterapia === null
            ? "—"
            : `${formatarPercentual(percentualSoroterapia)} dos casos com informação`,
        "#total-ate3h": formatarNumero(totais.atendimentoAte3h),
        "#percentual-ate3h":
          percentualAte3h === null
            ? "—"
            : `${formatarPercentual(percentualAte3h)} dos casos com tempo conhecido`,
      };

      Object.entries(valores).forEach(([seletor, valor]) => {
        const elemento = document.querySelector(seletor);
        if (elemento) elemento.textContent = valor;
      });
    }

