    function atualizarGraficoSoroterapiaGravidade(dadosFiltrados) {
      const matriz = new Map();
      const totais = new Map();
      const gravidadesPresentes = new Set();

      dadosFiltrados.forEach((linha) => {
        const gravidade = Number(linha[INDICE_CARDS.gravidade]);
        const casos = Number(linha[INDICE_CARDS.casos]);
        const sim = Number(linha[INDICE_CARDS.soroterapiaSim]);
        const conhecidos = Number(linha[INDICE_CARDS.soroterapiaConhecida]);
        const nao = Math.max(conhecidos - sim, 0);
        const ignorado = Math.max(casos - conhecidos, 0);

        gravidadesPresentes.add(gravidade);
        totais.set(gravidade, (totais.get(gravidade) || 0) + casos);

        [sim, nao, ignorado].forEach((valor, categoria) => {
          const chave = `${gravidade}-${categoria}`;
          matriz.set(chave, (matriz.get(chave) || 0) + valor);
        });
      });

      const indices = [...gravidadesPresentes].sort((a, b) => a - b);
      const categorias = [0, 1, 2];
      const rotulos = ["Sim", "Não", "Ignorado"];
      const cores = [
        CORES_SOROTERAPIA.sim,
        CORES_SOROTERAPIA.nao,
        CORES_SOROTERAPIA.ignorado,
      ];

      const datasets = criarDatasetsPercentuais(
        indices,
        categorias,
        matriz,
        totais,
        (indice) => rotulos[indice],
        (indice) => cores[indice]
      );

      renderizarGrafico(
        "soroterapia-gravidade",
        "#grafico-soroterapia-gravidade",
        configuracaoBarras100Empilhadas(
          indices.map((indice) => filtros.gravidades[indice]),
          datasets,
          "Gravidade"
        )
      );
    }

