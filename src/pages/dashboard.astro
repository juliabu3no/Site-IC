    function atualizarGraficoAmpolas(dadosFiltrados) {
      const contagens = new Map();
      const totaisPorSoro = new Map();

      dadosFiltrados.forEach((linha) => {
        const soro = Number(linha[INDICE_AMPOLAS.soro]);
        const faixa = Number(linha[INDICE_AMPOLAS.faixa]);
        const casos = Number(linha[INDICE_AMPOLAS.casos]);
        const chave = `${soro}-${faixa}`;

        contagens.set(chave, (contagens.get(chave) || 0) + casos);
        totaisPorSoro.set(
          soro,
          (totaisPorSoro.get(soro) || 0) + casos
        );
      });

      // Ordena pelos soros com maior número de casos na seleção atual.
      const indicesSoros = [...totaisPorSoro.keys()]
        .sort((a, b) => totaisPorSoro.get(b) - totaisPorSoro.get(a));

      const labels = indicesSoros.map(
        (indice) => filtros.soros[indice]
      );

      const datasets = filtros.faixas_ampolas.map((faixa, indiceFaixa) => {
        const casosAbsolutos = indicesSoros.map(
          (soro) => contagens.get(`${soro}-${indiceFaixa}`) || 0
        );

        const percentuais = indicesSoros.map((soro, indice) => {
          const total = totaisPorSoro.get(soro) || 0;
          return total > 0
            ? (casosAbsolutos[indice] / total) * 100
            : 0;
        });

        return {
          label: `${faixa} ampolas`,
          data: percentuais,
          casosAbsolutos,
          backgroundColor:
            CORES_FAIXAS_AMPOLAS[
              indiceFaixa % CORES_FAIXAS_AMPOLAS.length
            ],
          borderColor: "#FFFFFF",
          borderWidth: 1,
        };
      });

      renderizarGrafico("ampolas", "#grafico-ampolas", {
        type: "bar",
        data: {
          labels,
          datasets,
        },
        options: {
          indexAxis: "y",
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
            intersect: false,
          },
          plugins: {
            legend: {
              display: true,
              position: "bottom",
            },
            tooltip: {
              callbacks: {
                label: (contexto) => {
                  const casos =
                    contexto.dataset.casosAbsolutos?.[contexto.dataIndex] || 0;
                  const percentual = Number(contexto.raw);

                  return `${contexto.dataset.label}: ${formatarNumero(
                    casos
                  )} casos (${formatarPercentual(percentual, 1)})`;
                },
              },
            },
          },
          scales: {
            x: {
              stacked: true,
              beginAtZero: true,
              max: 100,
              title: {
                display: true,
                text: "Distribuição dos casos (%)",
              },
              ticks: {
                callback: (valor) => `${valor}%`,
              },
            },
            y: {
              stacked: true,
              title: {
                display: true,
                text: "Tipo de soro",
              },
            },
          },
        },
      });
    }

    function atualizarGraficoCategoria(
      nome,
      seletor,
      dadosFiltrados,
      rotulos,
      opcoes = {}
    ) {
      const {
        horizontal = false,
        ordenar = false,
        tituloCategoria = "",
        cores = null,
        corIgnorado = CORES_CATEGORIAS.ignorado,
      } = opcoes;

      const totais = somarPor(
        dadosFiltrados,
        INDICE_SERIE.categoria,
        INDICE_SERIE.casos
      );

      let indices = [...totais.keys()];

      if (ordenar) {
        indices.sort((a, b) => totais.get(b) - totais.get(a));
      } else {
        indices.sort((a, b) => a - b);
      }

      const labels = indices.map((indice) => rotulos[indice]);
      const valores = indices.map((indice) => totais.get(indice) || 0);

      const coresGrafico = indices.map((indice) => {
        if (cores?.[indice]) return cores[indice];
        const rotulo = rotulos[indice];
        return rotulo === "Ignorado"
          ? corIgnorado
          : CORES_CATEGORIAS.principal;
      });

      renderizarGrafico(
        nome,
        seletor,
        configuracaoBarrasCategorias(
          labels,
          valores,
          coresGrafico,
          horizontal,
          tituloCategoria
        )
      );
    }

