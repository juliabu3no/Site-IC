  <script>
    import Chart from "chart.js/auto";
    import * as L from "leaflet";

    // =========================
    // ESTADO E CONSTANTES
    // =========================
    let filtros = {};
    let dadosCards = [];
    let dadosTempo = [];
    let dadosMes = [];
    let dadosSemana = [];
    let dadosFaixaEtaria = [];
    let dadosSexo = [];
    let dadosLocalPicada = [];
    let dadosAcidenteTrabalho = [];
    let dadosRacaCor = [];
    let dadosEscolaridade = [];
    let dadosSubtipoAnimal = [];
    let dadosSoros = [];
    let dadosAmpolasTotais = [];
    let dadosAmpolas = [];
    let dadosTerritoriosGeojson = {
      municipio: null,
      regiao_saude: null,
