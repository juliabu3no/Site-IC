      "Escorpião": "#4F86C6",
      "Lagarta": "#0F766E",
      "Abelha": "#0A2C57",
      "Outros": "#64748B",
      "Outro": "#64748B",
      "Ignorado": "#CBD5E1",
    };

    const CORES_SOROTERAPIA = {
      sim: "#0A2C57",
      nao: "#6D4C8E",
      ignorado: "#94A3B8",
    };

    const CORES_EVOLUCAO = {
      "Cura": "#0F766E",
      "Óbito por acidente por animais peçonhentos": "#B91C1C",
      "Óbito por outras causas": "#6D4C8E",
      "Ignorado": "#94A3B8",
      "Sem informação": "#CBD5E1",
    };

    const CORES_FAIXAS_AMPOLAS = [
      "#4F86C6",
      "#0F766E",
      "#6D4C8E",
      "#C47A00",
      "#64748B",
      "#0A2C57",
    ];

    const CORES_CATEGORIAS = {
      principal: "#0A2C57",
      secundaria: "#4F86C6",
      destaque: "#C47A00",
      ignorado: "#94A3B8",
    };

    const COR_ZERO_PERCENTUAL_TERRITORIO = "#FFFDE7";

    const CORES_MAPA_TERRITORIAL = [
      "#FFFFCC",
      "#FFEDA0",
      "#FED976",
      "#FEB24C",
      "#FD8D3C",
      "#FC4E2A",
      "#E31A1C",
      "#B10026",
    ];

    const ROTULOS_INDICADOR_TERRITORIO = {
      casos: "Casos",
      obitos: "Óbitos",
      soroterapia: "Casos com soroterapia",
      letalidade: "Letalidade",
      proporcao_soroterapia: "Proporção com soroterapia",
    };

    const INDICADORES_PERCENTUAIS_TERRITORIO = new Set([
      "letalidade",
      "proporcao_soroterapia",
    ]);

    // Os cinco primeiros campos são iguais em todos os JSONs agregados.
    const INDICE_COMUM = {
      ano: 0,
      animal: 1,
      municipio: 2,
      gravidade: 3,
      evolucao: 4,
    };

    const INDICE_CARDS = {
      ...INDICE_COMUM,
      casos: 5,
      obitos: 6,
      soroterapiaSim: 7,
      soroterapiaConhecida: 8,
      atendimentoAte3h: 9,
      tempoConhecido: 10,
    };

    // mes.json, tempo.json, semana.json e soros.json:
    // [y, a, m, g, e, categoria, casos]
    const INDICE_SERIE = {
      categoria: 5,
      casos: 6,
    };

    const INDICE_AMPOLAS = {
      soro: 5,
      faixa: 6,
      casos: 7,
    };

    // ampolas_totais.json: [y, a, m, g, e, soro, ampolas, casos]
    const INDICE_AMPOLAS_TOTAIS = {
      soro: 5,
      ampolas: 6,
      casos: 7,
    };

    const ORDEM_TEMPOS = [1, 2, 3, 4, 5, 6, 9];
    const MAPA_TEMPOS = {
      1: "0 a 1 hora",
      2: "1 a 3 horas",
      3: "3 a 6 horas",
      4: "6 a 12 horas",
      5: "12 a 24 horas",
      6: "24 horas ou mais",
      9: "Ignorado",
    };

    const CORES_TEMPO = {
      1: "#0A2C57",
      2: "#4F86C6",
      3: "#0F766E",
      4: "#6D4C8E",
      5: "#C47A00",
      6: "#64748B",
      9: "#CBD5E1",
    };

    const ORDEM_MESES = Array.from({ length: 12 }, (_, indice) => indice + 1);
    const MAPA_MESES = {
      1: "Jan",
      2: "Fev",
      3: "Mar",
      4: "Abr",
      5: "Mai",
      6: "Jun",
      7: "Jul",
      8: "Ago",
      9: "Set",
      10: "Out",
      11: "Nov",
      12: "Dez",
    };

    const ORDEM_SEMANAS = Array.from({ length: 53 }, (_, indice) => indice + 1);

    // =========================
    // FUNÇÕES AUXILIARES
    // =========================
    function valoresSelecionados(nome) {
      const container = document.querySelector(`#${nome}-opcoes`);
      if (!container) return ["todos"];

      return Array.from(
        container.querySelectorAll('input[type="checkbox"]:checked')
      ).map((item) => item.value);
    }

    function obterSelecaoAtual() {
      return {
        ano: valoresSelecionados("ano"),
        animal: valoresSelecionados("animal"),
        municipio: valoresSelecionados("municipio"),
        gravidade: valoresSelecionados("gravidade"),
        evolucao: valoresSelecionados("evolucao"),
      };
    }

    function atendeFiltro(valor, selecionados) {
      return (
        selecionados.includes("todos") ||
        selecionados.includes(String(valor))
      );
    }

    function filtrarDados(dados, selecao) {
      return dados.filter((linha) =>
        atendeFiltro(linha[INDICE_COMUM.ano], selecao.ano) &&
        atendeFiltro(linha[INDICE_COMUM.animal], selecao.animal) &&
        atendeFiltro(linha[INDICE_COMUM.municipio], selecao.municipio) &&
        atendeFiltro(linha[INDICE_COMUM.gravidade], selecao.gravidade) &&
        atendeFiltro(linha[INDICE_COMUM.evolucao], selecao.evolucao)
      );
    }

    function formatarPercentual(valor, casas = 2) {
      if (valor === null || !Number.isFinite(valor)) return "—";
      return `${valor.toFixed(casas).replace(".", ",")}%`;
    }

    function formatarNumero(valor) {
      return Number(valor).toLocaleString("pt-BR");
    }

    function somarPor(dados, indiceChave, indiceValor) {
      const totais = new Map();

      dados.forEach((linha) => {
        const chave = Number(linha[indiceChave]);
        const valor = Number(linha[indiceValor]);
        totais.set(chave, (totais.get(chave) || 0) + valor);
      });

      return totais;
    }

    function agruparDuasCategorias(
      dados,
      indiceLinha,
      indiceColuna,
      indiceValor
    ) {
      const matriz = new Map();
      const totais = new Map();
      const linhas = new Set();

      dados.forEach((linha) => {
        const categoriaLinha = Number(linha[indiceLinha]);
        const categoriaColuna = Number(linha[indiceColuna]);
        const valor = Number(linha[indiceValor]);
        const chave = `${categoriaLinha}-${categoriaColuna}`;

        linhas.add(categoriaLinha);
        matriz.set(chave, (matriz.get(chave) || 0) + valor);
        totais.set(
          categoriaLinha,
          (totais.get(categoriaLinha) || 0) + valor
        );
      });

      return { matriz, totais, linhas: [...linhas] };
    }

    function criarDatasetsPercentuais(
      indicesLinhas,
      categorias,
      matriz,
      totais,
      obterRotulo,
      obterCor
    ) {
      return categorias.map((categoria) => {
        const casosAbsolutos = indicesLinhas.map(
          (linha) => matriz.get(`${linha}-${categoria}`) || 0
        );

        return {
          label: obterRotulo(categoria),
          data: indicesLinhas.map((linha, indice) => {
            const total = totais.get(linha) || 0;
            return total > 0
              ? (casosAbsolutos[indice] / total) * 100
              : 0;
          }),
          casosAbsolutos,
          backgroundColor: obterCor(categoria),
          borderColor: "#FFFFFF",
          borderWidth: 1,
        };
      });
    }

    function prepararSerieOrdenada(
      dados,
      ordem,
      mapaRotulos = null,
      preencherZeros = false
    ) {
      const totais = somarPor(
        dados,
        INDICE_SERIE.categoria,
        INDICE_SERIE.casos
      );

      // Em séries temporais, mantém meses/semanas sem casos como zero
      // para preservar a continuidade do eixo.
      const categorias = preencherZeros
        ? ordem
        : ordem.filter((categoria) => totais.has(categoria));

      return {
        labels: categorias.map((categoria) =>
          mapaRotulos ? mapaRotulos[categoria] : String(categoria)
        ),
        valores: categorias.map((categoria) => totais.get(categoria) || 0),
      };
    }

    function obterCorAnimal(nomeAnimal) {
      return CORES_ANIMAIS[nomeAnimal] || "#94A3B8";
    }

    function prepararSeriesPorAnimal(dados, ordemCategorias, mapaRotulos = null) {
      const animaisPresentes = [
        ...new Set(dados.map((linha) => Number(linha[INDICE_COMUM.animal])))
      ].sort((a, b) => a - b);

      const totais = new Map();

      dados.forEach((linha) => {
        const animal = Number(linha[INDICE_COMUM.animal]);
        const categoria = Number(linha[INDICE_SERIE.categoria]);
        const casos = Number(linha[INDICE_SERIE.casos]);
        const chave = `${animal}-${categoria}`;

        totais.set(chave, (totais.get(chave) || 0) + casos);
      });

      const labels = ordemCategorias.map((categoria) =>
        mapaRotulos ? mapaRotulos[categoria] : String(categoria)
      );

      const datasets = animaisPresentes.map((animal) => {
        const nomeAnimal = filtros.animais[animal];

        return {
          label: nomeAnimal,
          data: ordemCategorias.map(
            (categoria) => totais.get(`${animal}-${categoria}`) || 0
          ),
          backgroundColor: obterCorAnimal(nomeAnimal),
          borderColor: "#FFFFFF",
          borderWidth: 1,
        };
      });

      return { labels, datasets };
    }

    function renderizarGrafico(nome, seletor, configuracao) {
      const canvas = document.querySelector(seletor);
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const graficoAnterior = graficos.get(nome);
      if (graficoAnterior) graficoAnterior.destroy();

      graficos.set(nome, new Chart(canvas, configuracao));
    }

    function configuracaoPizza(labels, valores, cores) {
      return {
        type: "pie",
        data: {
          labels,
          datasets: [
            {
              data: valores,
              backgroundColor: cores,
              borderColor: "#FFFFFF",
              borderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: {
                usePointStyle: true,
                boxWidth: 10,
                padding: 14,
              },
            },
            tooltip: {
              callbacks: {
                label: (contexto) => {
                  const valor = Number(contexto.raw);
                  const total = contexto.dataset.data.reduce(
                    (soma, numero) => soma + Number(numero),
                    0
                  );
                  const percentual = total > 0 ? (valor / total) * 100 : 0;

                  return `${contexto.label}: ${formatarNumero(
                    valor
                  )} (${formatarPercentual(percentual, 1)})`;
                },
              },
            },
          },
        },
      };
    }

    function configuracaoBarrasCategorias(
      labels,
      valores,
      cores,
      horizontal = false,
      tituloCategoria = ""
    ) {
      return {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Casos",
              data: valores,
              backgroundColor: cores,
              borderRadius: 4,
            },
          ],
        },
        options: {
          indexAxis: horizontal ? "y" : "x",
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (contexto) =>
                  `Casos: ${formatarNumero(contexto.raw)}`,
              },
            },
          },
          scales: horizontal
            ? {
                x: {
                  beginAtZero: true,
                  title: {
                    display: true,
                    text: "Número de casos",
                  },
                  ticks: {
                    callback: (valor) => formatarNumero(valor),
                  },
                },
                y: {
                  title: {
                    display: Boolean(tituloCategoria),
                    text: tituloCategoria,
                  },
                },
              }
            : {
                x: {
                  title: {
                    display: Boolean(tituloCategoria),
                    text: tituloCategoria,
                  },
                },
                y: {
                  beginAtZero: true,
                  title: {
                    display: true,
                    text: "Número de casos",
                  },
                  ticks: {
                    callback: (valor) => formatarNumero(valor),
                  },
                },
              },
        },
      };
    }

    function configuracaoBarrasHorizontais(labels, valores, tituloEixoY) {
      return {
        type: "bar",
        data: {
          labels,
          datasets: [
            {
              label: "Casos",
