---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Otimização">
  <Container>
    <Sectionhead>
      <Fragment slot="title">
        Resultados de Otimização
      </Fragment>

      <Fragment slot="desc">
        Resultados de modelos matemáticos aplicados à distribuição territorial
        de soros antiveneno no estado de São Paulo.
      </Fragment>
    </Sectionhead>

    <main class="mx-auto max-w-5xl mt-14 mb-20">
      <section class="rounded-lg border border-gray-200 p-6">
        <h2 class="text-2xl font-bold text-gray-800">
          Página em desenvolvimento
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-slate-500">
          Esta página apresentará os resultados dos modelos de otimização,
          incluindo cobertura territorial, comparação entre a rede atual e
          cenários otimizados e alterações propostas na distribuição dos soros.
        </p>
      </section>
    </main>
  </Container>
</Layout>