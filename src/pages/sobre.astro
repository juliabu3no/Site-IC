---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Integrantes da equipe
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Publicações relacionadas ao projeto
const publications = [
  {
    title:
      "Estudo sobre a Localização de Unidades de Atendimento Soroterápico no Estado de São Paulo",
    authors:
      "Julia Graziosi Ortiz, Júlia Campos Bueno Paz Perez e Maristela Oliveira dos Santos",
    event: "LVIII Simpósio Brasileiro de Pesquisa Operacional (SBPO)",
    type: "Resumo",
    year: "2026",
    link: "",
  },
  {
    title:
        "Caracterização da Rede de Soro Antiveneno de São Paulo: Uma Análise a Partir de Dados Públicos",
    authors:
        "Júlia Campos Bueno Paz Perez, Julia Graziosi Ortiz, Cibele M. Russo, Oilson A. G. Junior, Maristela O. Santos e Hellen G. G. Santos",
    event:
        "Data Science for Social Good Brazilian Workshop (DS4SG) — 41º Simpósio Brasileiro de Banco de Dados (SBBD)",
    type: "Artigo",
    year: "2026",
    link: "https://sol.sbc.org.br/index.php/sbbd_estendido/article/view/44174",
    },
  {
    title:
        "Localização de Unidades para Atendimento Soroterápico no Estado de São Paulo",
   authors:
        "Júlia Campos Bueno Paz Perez, Julia Graziosi Ortiz, Cibele M. Russo, Oilson A. G. Junior, Maristela O. Santos e Hellen G. G. Santos",
    event:
        "XLV Congresso Nacional de Matemática Aplicada e Computacional — CNMAC 2026",
    type: "Pôster",
    year: "2026",
    link: "https://eventos.galoa.com.br/cnmac-2026/calendar/activity/22842?tz=device",
  },
  {
    title:
        "Localização de Unidades para Atendimento Soroterápico no Estado de São Paulo",
    authors:
        "Júlia Campos Bueno Paz Perez, Cibele M. Russo, Oilson A. G. Junior, Maristela O. Santos e Hellen G. G. Santos",
    event:
        "33º Simpósio Internacional de Iniciação Científica e Tecnológica da USP — SIICUSP",
    type: "Pôster",
    year: "2025",
    link: "",
  },
  {
    title:
        "Localização de Unidades para Atendimento Soroterápico no Estado de São Paulo",
    authors:
        "Júlia Campos Bueno Paz Perez, Cibele M. Russo, Oilson A. G. Junior, Maristela O. Santos e Hellen G. G. Santos",
    event:
        "XXVIII Simpósio de Matemática para a Graduação — SiM",
    type: "Apresentação Oral",
    year: "2025",
    link: "https://sites.google.com/usp.br/sim2025/eventos-e-programacao/trabalhos/apresenta%C3%A7%C3%B5es-orais?authuser=0",
  },
];
---

<Layout title="Sobre">
  <Container>

    <!-- TÍTULO DA PÁGINA -->
    <Sectionhead>
      <Fragment slot="title">Sobre</Fragment>

      <Fragment slot="desc">
        Conheça a produção científica, a participação em eventos, os pesquisadores envolvidos 
        e as agências de fomento que apoiam o projeto.
        <br/>
        Desenvolvido no Laboratório de Otimização (LOT) do Instituto de Ciências
        Matemáticas e de Computação (ICMC-USP).
      </Fragment>
    </Sectionhead>

    <!-- PRODUÇÃO CIENTÍFICA -->
    <section class="mx-auto max-w-4xl mt-14">

      <h2 class="text-3xl font-bold text-gray-800 mb-8">
        Produção Científica
      </h2>

      <div class="flex flex-col gap-5">

        {
          publications.map((publication) => (
            <div
              class="border border-gray-200 rounded-lg p-6 transition hover:shadow-md"
            >

              <div class="flex flex-wrap gap-2 mb-3">

                <span
                  class="text-xs font-medium bg-blue-50 text-blue-700 px-3 py-1 rounded-full"
                >
                  {publication.type}
                </span>

                <span
                  class="text-xs font-medium bg-gray-100 text-gray-600 px-3 py-1 rounded-full"
                >
                  {publication.event} · {publication.year}
                </span>

              </div>

              <h3 class="text-lg font-semibold text-gray-800">
                {publication.title}
              </h3>

              <p class="text-sm text-slate-500 mt-2">
                {publication.authors}
              </p>

              {
                publication.link && (
                  <a
                    href={publication.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block mt-4 text-blue-600 hover:underline text-sm"
                  >
                    Acessar conteúdo
                  </a>
                )
              }

            </div>
          ))
        }

      </div>
    </section>

    
    <!-- EQUIPE -->
    <h2 class="text-3xl font-bold text-gray-800 mx-auto max-w-4xl mt-20 mb-8">
      Equipe
    </h2>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl">
      {
        publishedTeamMembers.map((teamMemberEntry) => (
          <div class="group">
            <div class="w-full aspect-square">
              <Picture
                src={teamMemberEntry.data.avatar.src}
                alt={teamMemberEntry.data.avatar.alt}
                sizes="(max-width: 800px) 100vw, 400px"
                width={400}
                height={400}
                class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
              />
            </div>

            <div class="mt-4 text-center">

              <h2 class="text-lg font-semibold text-gray-800">
                {teamMemberEntry.data.name}
              </h2>

              <h3 class="text-sm text-slate-500">
                {teamMemberEntry.data.title}
              </h3>

              {
                teamMemberEntry.data.formation && (
                  <p class="text-sm text-slate-500">
                    {teamMemberEntry.data.formation}
                  </p>
                )
              }

              <div class="flex justify-center gap-3 mt-3 text-sm">

                {
                  teamMemberEntry.data.lattes && (
                    <a
                      href={teamMemberEntry.data.lattes}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-600 hover:underline"
                    >
                      Lattes
                    </a>
                  )
                }

                {
                  teamMemberEntry.data.email && (
                    <a
                      href={`mailto:${teamMemberEntry.data.email}`}
                      class="text-blue-600 hover:underline"
                    >
                      E-mail
                    </a>
                  )
                }

              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- AGRADECIMENTOS -->
    <section class="mx-auto max-w-4xl mt-20 mb-20 flex flex-col gap-2">
      <h2 class="m-0 text-3xl font-bold text-gray-800">
        Agradecimentos
      </h2>

      <p class="m-0 text-base text-slate-600 leading-relaxed">
        Este trabalho teve apoio do Conselho Nacional de Desenvolvimento
        Científico e Tecnológico (CNPq, proc. nº 2726 e 301967/2025-3),
        da Universidade de São Paulo, por meio do Programa Unificado de Bolsas
        (PUB, proc. nº 2300), e da Fundação de Amparo à Pesquisa do Estado de
        São Paulo (FAPESP, proc. nº 2022/05803-3 e 2024/08485-8).
      </p>
    </section>

  </Container>
</Layout>