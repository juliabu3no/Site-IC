---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Guia Informativo">
  <Container>

    <Sectionhead>
      <Fragment slot="title">
        Guia Informativo
      </Fragment>

      <Fragment slot="desc">
        Informações sobre prevenção, identificação e atendimento em acidentes com animais peçonhentos.
      </Fragment>
    </Sectionhead>

    <main class="mt-16">
      <p class="text-gray-600">
        Conteúdo em desenvolvimento.
      </p>
    </main>

  </Container>
</Layout>